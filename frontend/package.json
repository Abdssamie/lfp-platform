{
  "name": "convex-zen",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:all": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --filter=web --filter=@convex-zen/ui typecheck",
    "lint": "oxlint && oxfmt --write",
    "dev:web": "pnpm --filter web dev",
    "deploy:web": "pnpm --filter web deploy",
    "destroy": "pnpm --filter web destroy"
  },
  "dependencies": {
    "@convex-zen/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@convex-zen/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "typescript": "^5",
    "wrangler": "^4.83.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx}": [
      "oxlint",
      "oxfmt --write"
    ],
    "*.{json,jsonc}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
