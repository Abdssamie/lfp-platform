# =============================================================================
# LFP Platform Environment Configuration for Dokploy & Docker Compose
# =============================================================================

# Exposed Host Ports
GATEWAY_PORT=80
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend Configuration
PYTHONUNBUFFERED=1
CORS_ORIGINS=*

# Frontend Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
FASTAPI_INTERNAL_URL=http://backend:8000

# Dokploy / Domain Routing (e.g., lfp.yourdomain.com)
APP_DOMAIN=lfp.yourdomain.com
