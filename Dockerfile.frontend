# Frontend Dockerfile for LFP Platform (TanStack Start / React)
FROM node:22-bookworm-slim AS base

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10.33.2

WORKDIR /app

# Step 1: Install workspace dependencies with caching
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/packages ./packages
COPY frontend/apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# Step 2: Build the frontend application
COPY frontend/apps/web ./apps/web
COPY frontend/project.config.json ./
COPY frontend/bts.jsonc ./

ENV NODE_ENV=production
RUN pnpm --filter web build

# Step 3: Production runner
FROM node:22-bookworm-slim AS runner

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates wget && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10.33.2
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3000 \
    HOST=0.0.0.0

# Copy node_modules and built dist from builder stage
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/packages ./packages
COPY --from=base /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=base /app/apps/web ./apps/web

WORKDIR /app/apps/web

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ || exit 1

CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "3000"]
